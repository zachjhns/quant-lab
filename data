import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

names = ["BBCA", "USDIDR", "GOLD"]
prices = pd.concat(
    {n: pd.read_csv(f"data/{n}.csv", index_col=0, parse_dates=True)["Close"] for n in names},
    axis=1,
)
prices.tail()

def describe_returns(close):
    close = close.dropna()                      # drop days this market was closed
    daily = close.pct_change().dropna()         # daily return = today / yesterday - 1
    years = (close.index[-1] - close.index[0]).days / 365.25
    return {
        "Annual return": (close.iloc[-1] / close.iloc[0]) ** (1 / years) - 1,
        "Annual volatility": daily.std() * np.sqrt(252),
        "Best day": daily.max(),
        "Worst day": daily.min(),
        "% positive days": (daily > 0).mean(),
    }

describe_returns(prices["BBCA"])

table = pd.DataFrame({n: describe_returns(prices[n]) for n in names}).T
(table * 100).round(2)   # show as percentages

for n in names:
    daily = prices[n].dropna().pct_change()
    print(f"{n}: worst {daily.idxmin().date()} ({daily.min():.2%}), best {daily.idxmax().date()} ({daily.max():.2%})")

fig, ax = plt.subplots(figsize=(10, 5))
for n in names:
    close = prices[n].dropna()
    (close / close.iloc[0]).plot(ax=ax, label=n)   # every line starts at 1
ax.set_yscale("log")
ax.set_title("Growth of 1 (log scale)")
ax.legend()
plt.show()
